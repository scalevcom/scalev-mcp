{
  "name": "scalev-mcp",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@11.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "generate:docs-catalog": "node scripts/generate-docs-catalog.mjs",
    "generate:v3-catalog": "node scripts/generate-v3-catalog.mjs",
    "generate:catalog-surface-report": "node scripts/generate-catalog-surface-report.mjs",
    "generate:catalogs": "pnpm generate:v3-catalog && pnpm generate:docs-catalog",
    "check:docs-catalog": "node scripts/check-generated-catalog.mjs scripts/generate-docs-catalog.mjs src/generated/docsCatalog.ts",
    "check:v3-catalog": "node scripts/check-generated-catalog.mjs scripts/generate-v3-catalog.mjs src/generated/v3Catalog.ts",
    "check:catalogs": "pnpm check:v3-catalog && pnpm check:docs-catalog",
    "check:assets": "node scripts/check-assets.mjs",
    "check:catalog-risk": "node scripts/check-catalog-risk.mjs",
    "check:catalog-surface-report": "node scripts/generate-catalog-surface-report.mjs --check",
    "check:evidence-redaction": "node scripts/check-evidence-redaction.mjs",
    "check:reviewer-evidence": "node scripts/check-reviewer-evidence.mjs",
    "check:reviewer-evidence:final": "node scripts/check-reviewer-evidence.mjs --final",
    "check:logging-privacy": "node scripts/check-logging-privacy.mjs",
    "check:submission-text": "node scripts/check-submission-text.mjs",
    "check:submission-package": "node scripts/check-submission-package.mjs",
    "check:submission-workspace": "node scripts/check-submission-workspace.mjs",
    "check:submission-package:final": "node scripts/check-submission-package.mjs --final",
    "check:submission-local": "pnpm check:catalogs && pnpm check:assets && pnpm check:catalog-risk && pnpm check:catalog-surface-report && pnpm check:logging-privacy && pnpm check:evidence-redaction && pnpm check:reviewer-evidence && pnpm check:submission-text && pnpm check:submission-package && pnpm check:submission-workspace && pnpm typecheck && pnpm test && pnpm wrangler deploy --dry-run",
    "check:submission-final": "pnpm check:submission-local && pnpm check:reviewer-evidence:final && pnpm check:submission-package:final && pnpm check:live-readiness",
    "check:live-readiness": "node scripts/check-live-readiness.mjs",
    "check:live-readiness:report": "node scripts/check-live-readiness.mjs --report-only",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@sentry/cloudflare": "10.53.1",
    "agents": "0.12.0",
    "zod": "4.4.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.15.2",
    "@cloudflare/workers-types": "4.20260430.1",
    "@types/json-schema": "7.0.15",
    "typescript": "5.9.3",
    "vitest": "4.1.5",
    "wrangler": "4.87.0",
    "yaml": "2.8.3"
  }
}
