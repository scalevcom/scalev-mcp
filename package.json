{
  "name": "nexus-mcp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "generate:docs-catalog": "node scripts/generate-docs-catalog.mjs",
    "generate:v3-catalog": "node scripts/generate-v3-catalog.mjs",
    "generate:catalogs": "pnpm generate:v3-catalog && pnpm generate:docs-catalog",
    "check:docs-catalog": "node scripts/generate-docs-catalog.mjs && git diff --exit-code -- src/generated/docsCatalog.ts",
    "check:v3-catalog": "node scripts/generate-v3-catalog.mjs && git diff --exit-code -- src/generated/v3Catalog.ts",
    "check:catalogs": "pnpm check:v3-catalog && pnpm check:docs-catalog",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "agents": "0.12.0",
    "zod": "4.4.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.15.2",
    "@cloudflare/workers-types": "4.20260430.1",
    "@types/json-schema": "7.0.15",
    "typescript": "5.9.3",
    "vitest": "4.1.5",
    "wrangler": "4.87.0",
    "yaml": "2.8.3"
  }
}
